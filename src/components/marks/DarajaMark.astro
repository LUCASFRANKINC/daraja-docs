---
/**
 * The Laravel Daraja mark without its tile: the curve takes the text colour
 * and the dot stays teal, so it sits on any background. The tiled version is
 * kept for favicons and OG images, which bring no background of their own.
 */
interface Props {
    size?: number;
    class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="6.5 8 19 15.5" aria-hidden="true">
    <path
        d="M9 21.5c2.6 0 3.4-2.1 4.4-5.2 1-3.2 2-6.3 5.3-6.3 2.2 0 3.6 1.3 4.3 2.9"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"></path>
    <circle cx="10.5" cy="12.5" r="2.1" fill="#0FA3B1"></circle>
</svg>
