---
/** The Eazysoft "Wink" mark, as the brand book draws it. The arc takes the text colour. */
interface Props {
    size?: number;
}

const { size = 12 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
    <path d="M52 32 A20 20 0 1 0 46.14 46.14" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"></path>
    <rect x="24" y="28.5" width="36" height="7" rx="3.5" fill="#0FA3B1"></rect>
    <circle cx="9.5" cy="32" r="5.04" fill="#0FA3B1"></circle>
</svg>
