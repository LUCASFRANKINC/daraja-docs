---
/** An eyebrow, a heading and an optional intro: the home page's section opener. */
interface Props {
    eyebrow: string;
    title: string;
    id?: string;
}

const { eyebrow, title, id } = Astro.props;
---

<div class="section-heading">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={id}>{title}</h2>
    <slot />
</div>

<style>
    .section-heading {
        max-width: 42rem;
        margin-bottom: 2rem;
    }

    .eyebrow {
        margin: 0 0 0.5rem;
        font-family: var(--sl-font-mono);
        font-size: var(--sl-text-xs);
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--sl-color-text-accent);
    }

    h2 {
        margin: 0;
        font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
        line-height: 1.1;
        font-weight: 700;
        letter-spacing: -0.035em;
        color: var(--sl-color-white);
        text-wrap: balance;
    }

    .section-heading :global(p:not(.eyebrow)) {
        margin: 0.75rem 0 0;
        font-size: var(--sl-text-lg);
        color: var(--sl-color-gray-2);
    }
</style>
